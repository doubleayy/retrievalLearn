# Required: the planner turns natural language into SQL and Cypher.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults shown.
# Drop to claude-sonnet-5 or claude-haiku-4-5 to cut per-query cost.
PLANNER_MODEL=claude-opus-5
PLANNER_EFFORT=low
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Comma-separated exact origins. Vercel preview URLs are matched by regex too.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

RATE_LIMIT_PER_MIN=20
MAX_QUERY_CHARS=300
